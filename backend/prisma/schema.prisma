datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Practice {
  id           String   @id @default(uuid())
  name         String
  legalName    String?
  specialty    String?
  practiceType String?
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  taxId        String?
  npi          String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  phone        String?
  email        String?
  website      String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  providers    Provider[]
  patients     Patient[]
  leads        Lead[]
  settings     PracticeSetting[]
  claims       Claim[]
  denials      Denial[]
  appointments Appointment[]
  insurances   Insurance[]
  tasks        Task[]
  messages     Message[]
  priorAuths   PriorAuthorization[]
  campaigns    Campaign[]
  seoKeywords  SeoKeyword[]
  conversations Conversation[]
}

model User {
  id                 String    @id @default(uuid())
  practiceId         String?   // NULL for SUPER_ADMIN
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               String    @default("VIEWER") // SUPER_ADMIN, PRACTICE_OWNER, PRACTICE_MANAGER, BILLING_STAFF, FRONT_DESK, VIEWER
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  isDemo             Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  practice          Practice?  @relation(fields: [practiceId], references: [id])
  tasksAssigned     Task[]     @relation("AssignedTasks")
  tasksCreated      Task[]     @relation("CreatedTasks")
  denialAssignments Denial[]   @relation("AssignedDenials")
  auditLogs         AuditLog[]
  notes             Note[]
  notifications     Notification[]
  messagesSent      Message[]  @relation("MessagesSent")
  messagesReceived  Message[]  @relation("MessagesReceived")
  conversationsAsA  Conversation[] @relation("ConversationParticipantA")
  conversationsAsB  Conversation[] @relation("ConversationParticipantB")
  chatMessages      ConversationMessage[]  @relation("ConversationMessageSender")

  @@index([practiceId])
}

model Provider {
  id             String   @id @default(uuid())
  practiceId     String
  firstName      String
  lastName       String
  npi            String   @unique
  specialty      String?
  licenseNumber  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  practice       Practice  @relation(fields: [practiceId], references: [id])
  appointments   Appointment[]
  claims         Claim[]

  @@index([practiceId])
}

model Patient {
  id             String   @id @default(uuid())
  practiceId     String
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         String?  // MALE, FEMALE, OTHER
  ssn            String?  // Encrypted or masked
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zipCode        String?
  phone          String?
  email          String?
  memberId       String?
  groupNumber    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  practice           Practice             @relation(fields: [practiceId], references: [id])
  appointments       Appointment[]
  claims             Claim[]
  priorAuthorizations PriorAuthorization[]

  @@index([practiceId])
}

model Appointment {
  id             String   @id @default(uuid())
  practiceId     String?
  patientId      String
  providerId     String
  startTime      DateTime
  endTime        DateTime
  visitType      String?
  status         String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELED, NO_SHOW
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  practice       Practice? @relation(fields: [practiceId], references: [id])
  patient        Patient   @relation(fields: [patientId], references: [id])
  provider       Provider  @relation(fields: [providerId], references: [id])

  @@index([practiceId])
  @@index([patientId])
  @@index([providerId])
}

model Insurance {
  id                String   @id @default(uuid())
  practiceId        String?
  name              String
  payerId           String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  phone             String?
  timelyFilingDays  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  practice       Practice? @relation(fields: [practiceId], references: [id])
  claims         Claim[]
  policies       PatientPolicy[]

  @@index([practiceId])
}

model PatientPolicy {
  id             String   @id @default(uuid())
  insuranceId    String
  patientId      String
  policyNumber   String
  groupNumber    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  insurance      Insurance @relation(fields: [insuranceId], references: [id])
}

model Claim {
  id              String   @id @default(uuid())
  claimNumber     String   @unique
  practiceId      String?
  patientId       String
  providerId      String
  insuranceId     String?
  dateOfService   DateTime
  submittedDate   DateTime?
  billedAmount    Float
  allowedAmount   Float?
  paidAmount      Float?
  patientBalance  Float?
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, ACCEPTED, PENDING, PAID, DENIED, REJECTED
  icdCodes        String // JSON string
  cptCodes        String // JSON string
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice?     @relation(fields: [practiceId], references: [id])
  patient         Patient       @relation(fields: [patientId], references: [id])
  provider        Provider      @relation(fields: [providerId], references: [id])
  insurance       Insurance?    @relation(fields: [insuranceId], references: [id])
  denials         Denial[]
  payments        Payment[]
  statusHistory   ClaimStatusHistory[]

  @@index([practiceId])
  @@index([patientId])
  @@index([providerId])
  @@index([insuranceId])
  @@index([status])
}

model ClaimStatusHistory {
  id              String   @id @default(uuid())
  claimId         String
  fromStatus      String?
  toStatus        String
  changedAt       DateTime @default(now())
  notes           String?
  
  claim           Claim    @relation(fields: [claimId], references: [id])

  @@index([claimId])
}

model Denial {
  id              String   @id @default(uuid())
  practiceId      String?
  claimId         String
  denialDate      DateTime
  denialReason    String
  denialCode      String?
  deniedAmount    Float
  recoveredAmount Float    @default(0)
  status          String   @default("NEW") // NEW, UNDER_REVIEW, DOCUMENTATION_NEEDED, APPEAL_SUBMITTED, RESOLVED, WRITTEN_OFF
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedToId    String?
  followUpDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice? @relation(fields: [practiceId], references: [id])
  claim           Claim    @relation(fields: [claimId], references: [id])
  assignedTo      User?    @relation("AssignedDenials", fields: [assignedToId], references: [id])
  notes           Note[]
  appeals         Appeal[]

  @@index([practiceId])
  @@index([claimId])
  @@index([assignedToId])
  @@index([status])
}

model Payment {
  id               String   @id @default(uuid())
  claimId          String
  paidDate         DateTime
  amount           Float
  adjustmentAmount Float?
  paymentMethod    String?  // EFT, CHECK, CREDIT_CARD
  eraNumber        String?
  checkNumber      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  claim            Claim    @relation(fields: [claimId], references: [id])

  @@index([claimId])
}

model Task {
  id              String   @id @default(uuid())
  practiceId      String?
  title           String
  description     String?
  dueDate         DateTime?
  assignedToId    String?
  createdById     String
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice? @relation(fields: [practiceId], references: [id])
  assignedTo      User?    @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy       User     @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([practiceId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
}

model Note {
  id              String   @id @default(uuid())
  content         String
  userId          String
  denialId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  denial          Denial?  @relation(fields: [denialId], references: [id])

  @@index([userId])
  @@index([denialId])
}

model Appeal {
  id              String   @id @default(uuid())
  denialId        String
  submittedDate   DateTime
  reason          String
  outcome         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  denial          Denial   @relation(fields: [denialId], references: [id])

  @@index([denialId])
}

model PriorAuthorization {
  id              String   @id @default(uuid())
  practiceId      String?
  patientId       String
  insuranceId     String?
  authNumber      String?
  service         String
  requestedDate   DateTime
  validFrom       DateTime?
  validTo         DateTime?
  expirationDate  DateTime?
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, DENIED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice? @relation(fields: [practiceId], references: [id])
  patient         Patient  @relation(fields: [patientId], references: [id])

  @@index([practiceId])
  @@index([patientId])
  @@index([status])
}

model Message {
  id              String   @id @default(uuid())
  practiceId      String?
  senderId        String
  receiverId      String
  subject         String?
  content         String
  isRead          Boolean  @default(false)
  patientId       String?
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("TODO")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice? @relation(fields: [practiceId], references: [id])
  sender          User     @relation("MessagesSent", fields: [senderId], references: [id])
  receiver        User     @relation("MessagesReceived", fields: [receiverId], references: [id])

  @@index([practiceId])
  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id              String   @id @default(uuid())
  userId          String
  title           String
  message         String
  isRead          Boolean  @default(false)
  type            String   @default("GENERAL") // GENERAL, TASK, DENIAL, CLAIM, SYSTEM
  link            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String
  action          String
  entityType      String
  entityId        String
  details         String? // JSON string
  ipAddress       String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

model Lead {
  id              String   @id @default(uuid())
  practiceId      String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  source          String?
  service         String?
  status          String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, CLOSED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice @relation(fields: [practiceId], references: [id])

  @@index([practiceId])
  @@index([status])
}

model PracticeSetting {
  id              String   @id @default(uuid())
  practiceId      String
  key             String
  value           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice @relation(fields: [practiceId], references: [id])

  @@unique([practiceId, key])
}

model Campaign {
  id              String   @id @default(uuid())
  practiceId      String
  name            String
  type            String
  status          String   @default("Active")
  budget          String
  clicks          Int      @default(0)
  cost            String
  cpa             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice @relation(fields: [practiceId], references: [id])

  @@index([practiceId])
}

model SeoKeyword {
  id              String   @id @default(uuid())
  practiceId      String
  term            String
  position        Int
  volume          String
  trend           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practice        Practice @relation(fields: [practiceId], references: [id])

  @@index([practiceId])
}

model Conversation {
  id               String    @id @default(uuid())
  practiceId       String
  participantAId   String
  participantBId   String
  createdAt        DateTime  @default(now())
  lastMessageAt    DateTime?

  practice         Practice  @relation(fields: [practiceId], references: [id])
  participantA     User                  @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantB     User                  @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  messages         ConversationMessage[]

  @@unique([practiceId, participantAId, participantBId])
  @@index([practiceId])
  @@index([participantAId])
  @@index([participantBId])
}

model ConversationMessage {
  id               String       @id @default(uuid())
  conversationId   String
  senderId         String
  body             String
  createdAt        DateTime     @default(now())
  readAt           DateTime?

  conversation     Conversation @relation(fields: [conversationId], references: [id])
  sender           User         @relation("ConversationMessageSender", fields: [senderId], references: [id])

  @@map("messages")
  @@index([conversationId])
  @@index([senderId])
}
